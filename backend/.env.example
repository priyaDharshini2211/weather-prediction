# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:2000

# --- Database (Neon / any PostgreSQL). Leave empty to fall back to local SQLite. ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- LLM: any OpenAI-compatible endpoint serving an open-source model ---
# Local Ollama (default):   ollama pull llama3.1:8b
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
LLM_API_KEY=ollama
# Hosted open-source example (Groq):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
# LLM_API_KEY=your-groq-key

# --- Weather ---
# https://openweathermap.org/api  (free key works for current weather + 5-day forecast).
# If empty, the app transparently uses Open-Meteo (no key needed).
OPENWEATHER_API_KEY=

MAX_UPLOAD_MB=5

# https://www.weatherapi.com (optional; free plan = 3-day forecast, ~7 days history)
WEATHERAPI_KEY=

# Extra token budget for reasoning models (Gemma/Gemini 3 "thinking"); set 0 for plain models
LLM_REASONING_TOKENS=3000

# --- Embeddings / vector search (pgvector in the same PostgreSQL database) ---
# Default: local open-source model, no key needed (downloaded once into EMBEDDING_CACHE_DIR, ~70 MB).
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# EMBEDDING_PROVIDER=openai          # any OpenAI-compatible /embeddings API; also set EMBEDDING_BASE_URL / EMBEDDING_API_KEY
# Retrieval tuning (see README "Retrieval"): hybrid = vectors + BM25 fused with Reciprocal Rank Fusion
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SIMILARITY=0.45
RERANK_ENABLED=false
